# Gemini API Key (Required for AI Agents)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Supabase (Required for Database and Auth)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Delivery (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=hello@yourdomain.com

# Event Bus (Optional - defaults to in-memory)
# AWS_SQS_QUEUE_URL=your_sqs_queue_url
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# RAG & Vector Database (Phase 2)
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_ENVIRONMENT=your_pinecone_env
# PINECONE_INDEX_NAME=ale-knowledge-base
# OPENAI_API_KEY=your_openai_key_for_embeddings

# Enrichment Providers (Phase 3)
# CLEARBIT_API_KEY=your_clearbit_api_key
# APOLLO_API_KEY=your_apollo_api_key

# Scoring Configuration
ALE_SCORING_USE_POSTGRES_OUTCOMES=false
ALE_SCORING_HISTORICAL_SEED=[]

# Agent Budgets & Constraints
ALE_LLM_MAX_PROMPT_CHARS=12000
ALE_LLM_MAX_ESTIMATED_TOKENS=3000
ALE_LLM_USD_PER_1K_TOKENS=0.001
ALE_LLM_MAX_USD_PER_REQUEST=0.02

# Agent Thresholds & Decisions
ALE_THRESHOLD_QUALIFY_SCORE=70
ALE_THRESHOLD_QUALIFY_CONFIDENCE=0.72
ALE_THRESHOLD_REVIEW_SCORE_MIN=50
ALE_THRESHOLD_REVIEW_CONFIDENCE_MIN=0.55
ALE_THRESHOLD_AUTO_ESCALATE_CONFIDENCE=0.45

# Scoring Weights (Sum to 100)
ALE_WEIGHT_ICP_FIT=40
ALE_WEIGHT_INTENT_SIGNALS=30
ALE_WEIGHT_DATA_QUALITY=20
ALE_WEIGHT_TIMING=10

# RAG Configuration
ALE_RAG_K=10
ALE_RAG_MIN_SIMILARITY=0.72
ALE_RAG_MIN_SAMPLE_SIZE=5
ALE_RAG_LOOKBACK_DAYS=90

# Enrichment Provider Priorities
ALE_ENRICHMENT_PRIORITY=clearbit,apollo,hunter,gemini
ALE_ENRICHMENT_CLEARBIT_CONFIDENCE_FLOOR=0.80
ALE_ENRICHMENT_APOLLO_CONFIDENCE_FLOOR=0.70
ALE_ENRICHMENT_GEMINI_CONFIDENCE_CAP=0.60
ALE_ENRICHMENT_CACHE_TTL_SEC=86400

# Composer Constraints
ALE_COMPOSER_WORD_COUNT_MIN=50
ALE_COMPOSER_WORD_COUNT_MAX=150
ALE_COMPOSER_MAX_EXCLAMATIONS=1
ALE_COMPOSER_SPAM_SCORE_THRESHOLD=3.0

# Observability
# SENTRY_DSN=your_sentry_dsn
# AXIOM_DATASET=ale-logs
# AXIOM_TOKEN=your_axiom_token
